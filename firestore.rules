rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Fleet vehicles
    match /vehicles/{vehicleId} {
      allow get, list: if true; // Publicly visible fleet
      allow create, update: if isSignedIn(); // In campus app, users or system can update status
      allow delete: if false;
    }

    // Rentals
    match /rentals/{rentalId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Peer-to-peer marketplace items
    match /marketplace_items/{itemId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn(); // Seller can edit, buyer can escrow or mark sold
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
  }
}
